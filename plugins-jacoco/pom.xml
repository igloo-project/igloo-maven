<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.iglooproject</groupId>
    <artifactId>plugins-processor</artifactId>
    <version>${revision}</version>
    <relativePath>../plugins-processor</relativePath>
  </parent>
  <artifactId>plugins-jacoco</artifactId>
  <packaging>pom</packaging>
  <name>Maven - Jacoco plugin configuration</name>
  <description>This module configures jacoco plugin.</description>
  <properties>
    <!-- agent includes: class names (e.g. basicapp.*, several patterns separated by ':' ) -->
    <igloo.jacoco.include>org.iglooproject.*</igloo.jacoco.include>
    <!-- report includes: class file paths (e.g. basicapp/**) ; module classes are all application classes by default -->
    <igloo.jacoco.report.include>**/*</igloo.jacoco.report.include>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${igloo.jacoco-maven-plugin.version}</version>
          <configuration>
            <destFile>${project.build.directory}/coverage-reports/jacoco-unit.exec</destFile>
            <dataFile>${project.build.directory}/coverage-reports/jacoco-unit.exec</dataFile>
            <!-- do not use <includes> here, includes are not shared: agent uses class names, report uses class file paths -->
          </configuration>
          <executions>
            <execution>
              <!-- this goal modify argLine system property to append jacoco java-agent -->
              <id>jacoco-initialize</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <includes>
                  <!-- this allows better performance and memory usage for coverage computation -->
                  <include>${igloo.jacoco.include}</include>
                </includes>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-site</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>package</phase>
              <configuration>
                <includes>
                  <include>${igloo.jacoco.report.include}</include>
                </includes>
                <excludes>
                  <!-- bindgen generated classes (jakarta @Generated has SOURCE retention, so jacoco cannot filter them) -->
                  <exclude>**/*Binding.class</exclude>
                  <exclude>**/*BindingPath.class</exclude>
                </excludes>
              </configuration>
            </execution>
            <execution>
              <id>jacoco-integration-site</id>
              <goals>
                <goal>report-integration</goal>
              </goals>
              <phase>verify</phase>
              <configuration>
                <includes>
                  <include>${igloo.jacoco.report.include}</include>
                </includes>
                <excludes>
                  <!-- bindgen generated classes (jakarta @Generated has SOURCE retention, so jacoco cannot filter them) -->
                  <exclude>**/*Binding.class</exclude>
                  <exclude>**/*BindingPath.class</exclude>
                </excludes>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
